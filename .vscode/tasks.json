{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DB: Build firmware",
      "type": "shell",
      "command": "platformio",
      "args": [
        "run",
        "-e",
        "digital_board"
      ],
      "group": "build",
      "problemMatcher": ["$platformio"]
    },
    {
      "label": "DB: Build and deploy firmware",
      "type": "shell",
      "command": "platformio",
      "args": [
        "run",
        "-e",
        "digital_board",
        "--target",
        "upload"
      ],
      "group": "build",
      "problemMatcher": ["$platformio"]
    },

        {
      "label": "Core2: Build firmware",
      "type": "shell",
      "command": "platformio",
      "args": [
        "run",
        "-e",
        "core2"
      ],
      "group": "build",
      "problemMatcher": ["$platformio"]
    },
    {
      "label": "Core2: Build and deploy firmware",
      "type": "shell",
      "command": "platformio",
      "args": [
        "run",
        "-e",
        "core2",
        "--target",
        "upload"
      ],
      "group": "build",
      "problemMatcher": ["$platformio"]
    },

    {
      "label": "Build Releases",
      "type": "shell",
      "command": "platformio",
      "args": [
        "run",
        "-e",
        "core2_release",
        "-e",
        "digital_board_release"
      ],
      "group": "build",
      "problemMatcher": ["$platformio"]
    },
  ]
}
